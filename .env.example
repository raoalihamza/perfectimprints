# Sanity (Next.js app + embedded /admin3773752 studio)
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=
SANITY_WEBHOOK_SECRET=
# Sanity (standalone studio at localhost:3333 via `pnpm sanity:dev`)
SANITY_STUDIO_PROJECT_ID=your-project-id
SANITY_STUDIO_DATASET=production

# DeepSeek AI
DEEPSEEK_API_KEY=

# Site Refresh panel (Sanity Studio → "Site Refresh"). Lets Patrick trigger /
# watch / cancel the data-refresh GitHub Actions workflows from the API route
# app/api/sanity/workflows. GITHUB_WORKFLOW_TOKEN is a GitHub fine-grained PAT
# scoped to the target repo with: Actions read & write, Pull requests read &
# write, Contents read & write. It stays SERVER-SIDE (never shipped to the
# browser). The repo is configurable so staging can point at the test repo.
GITHUB_WORKFLOW_TOKEN=
# Default repo is the PRODUCTION repo pbnj53/perfectimprints. On staging, point
# these at raoalihamza/perfectimprints to test against the staging repo.
GITHUB_REPO_OWNER=pbnj53
GITHUB_REPO_NAME=perfectimprints

# Email (Gmail SMTP via Nodemailer)
GMAIL_USER=patrick@perfectimprints.com
GMAIL_APP_PASSWORD=
LEAD_EMAIL_TO=patrick@perfectimprints.com
LEAD_EMAIL_FROM=patrick@perfectimprints.com

# Cloudflare Turnstile (lead-form CAPTCHA, managed/auto-detect mode).
# Create a free Turnstile site in the Cloudflare dashboard to get both keys.
# Leave BOTH blank to disable the CAPTCHA (the lead form still works; server
# verification is skipped). The CAPTCHA activates automatically once both are set.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Site
# Production = the www origin (canonical). The apex perfectimprints.com
# 308-redirects to www at the Vercel domain level (primary domain), so every
# emitted URL — canonical, OG, sitemap, robots, schema — derives from this value.
# Staging uses https://dev.perfectimprints.com.
NEXT_PUBLIC_SITE_URL=https://www.perfectimprints.com
NEXT_PUBLIC_GEIGER_HOST=https://patrickblack.geiger.com

# Analytics
GA4_MEASUREMENT_ID=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
# Google Tag Manager container id. Loaded via @next/third-parties (deferred, off
# the render-blocking path). Patrick manages GA, live chat, and all other tags
# from the GTM dashboard. Leave blank to render NOTHING (no GTM on staging).
NEXT_PUBLIC_GTM_ID=GTM-MCQP434P
