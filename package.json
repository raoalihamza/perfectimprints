    "start": "next start",
    "lint": "echo 'lint disabled by project preference'",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "sanity:dev": "cd sanity && sanity dev",
    "sanity:deploy": "cd sanity && sanity deploy",
    "import-urls": "tsx scripts/url-import/import-urls.ts",
    "build:search-index": "tsx scripts/search-index/build-index.ts",
    "build:category-list": "tsx scripts/build-category-list.ts",
    "build:product-list": "tsx scripts/build-product-list.ts",
    "build:custom-category-slugs": "tsx scripts/build-custom-category-slugs.ts",
    "warmup": "tsx scripts/warmup/warmup-facets.ts",
