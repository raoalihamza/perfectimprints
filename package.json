    "@sanity/vision": "^3.62.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "fuse.js": "^7.0.0",
    "next": "^16.2.0",
    "next-sanity": "^9.8.0",
    "nodemailer": "^6.9.16",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sanity": "^3.62.0",
    "styled-components": "^6.1.13",
    "tailwind-merge": "^2.5.4",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@sanity/block-tools": "^3.62.0",
